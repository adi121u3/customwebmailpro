# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional environment variables for mail and Rackspace webmail router integration
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=
APP_TOKEN=
MAIL_EMAIL=
MAIL_SENDER_NAME=
MAIL_PASSWORD=
IMAP_HOST=secure.emailsrvr.com
IMAP_PORT=993
IMAP_SECURE=true
SMTP_HOST=secure.emailsrvr.com
SMTP_PORT=465
SMTP_SECURE=true
MAIL_REJECT_UNAUTHORIZED=true
RACKSPACE_ROUTER_BASE_URL=https://apps.rackspace.com/a/router
RACKSPACE_ALLOWED_HOSTS=apps.rackspace.com,webmail.emailsrvr.com
RACKSPACE_SENT_FOLDER=
RACKSPACE_WSID_FILE=
RACKSPACE_COOKIE_FILE=
RACKSPACE_WSID=
RACKSPACE_COOKIE_HEADER=
RACKSPACE_DEBUG=false

